// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TECHNICIAN
  // Legacy values (kept for back-compat with existing DB rows). New users
  // should be created as ADMIN or TECHNICIAN only — OPERATOR maps to admin
  // privileges in the permission matrix; VIEWER is read-only legacy.
  ADMIN
  OPERATOR
  VIEWER
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  PENDING
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  WOMPI
  OTHER
}

enum NotificationType {
  INVOICE_CREATED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAYMENT_REMINDER       // FASE 4: auto-collection campaign sends
  SERVICE_SUSPENDED
  SERVICE_ACTIVATED
  INSTALLATION_SCHEDULED
  GENERAL_ANNOUNCEMENT
  INCOMING // inbound WhatsApp message (webhook)
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  TELEGRAM
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(TECHNICIAN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions          Session[]
  clientUpdateTokens ClientUpdateToken[]
  payments          Payment[]
  bulkOperations    BulkOperationLog[]
  collectionWindows CollectionWindow[]
  routerBackups     RouterBackup[]
  billingCycles     BillingCycle[]
  paymentLinkCampaigns PaymentLinkCampaign[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Zone {
  id          Int      @id @default(autoincrement())
  wisphubId   String?  @unique
  name        String   @unique
  description String?
  color       String?  @default("#3b82f6")
  routerId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  router         Router?         @relation(fields: [routerId], references: [id])
  clients        Client[]
  networkDevices NetworkDevice[]

  @@index([routerId])
  @@map("zones")
}

model Client {
  id               String       @id @default(cuid())
  wisphubId        String?      @unique
  name             String
  email            String?      @unique
  phone            String
  address          String
  neighborhood     String?
  city             String
  nit              String?      @unique
  documentType     String? // CC, NIT, CE, TI, PAS
  documentNumber   String?      @unique
  status           ClientStatus @default(PENDING)
  planId           String?
  zoneId           Int?
  balance          Int          @default(0) // in cents
  monthlyFee       Int          @default(0) // in cents — per-client price (WispHub-style)
  installationDate DateTime?
  contractDate     DateTime?
  cutoffDate       DateTime?
  coordinates      String?
  // PPPoE / service columns were dropped in migration 20260605170000.
  // MikrotikAccount is now the single source of truth — see the relation
  // below. Reads that used to go through Client.pppoeUsername / serviceIp
  // must read mikrotikAccount.username / remoteAddress / localAddress.
  vlan             String?
  wisphubRouterId  String?
  notes            String?
  mikrotikId       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  plan            Plan?                 @relation(fields: [planId], references: [id])
  zone            Zone?                 @relation(fields: [zoneId], references: [id])
  devices         Device[]
  invoices        Invoice[]
  payments        Payment[]
  paymentAttempts PaymentAttempt[]
  mikrotikAccount MikrotikAccount?
  evidencePhotos  ClientEvidencePhoto[]
  updateTokens    ClientUpdateToken[]
  clientUser          ClientUser?
  paymentLinks        PaymentLink[]
  clientNotifications ClientNotification[]

  @@map("clients")
}

// Single-use, time-boxed token that grants a public URL the ability to
// patch a whitelisted subset of a Client's fields (contact data + ID
// document + evidence photos). Created by a technician/admin from
// /clients/[id], sent to the customer over one or more channels
// (Email/WhatsApp/Telegram). Status transitions:
//   pending → used     when the customer submits the form
//   pending → expired  when expiresAt < now() and a sweep marks it
// Once used or expired the GET endpoint MUST refuse to load the form.
model ClientUpdateToken {
  id           String    @id @default(cuid())
  clientId     String
  // 32 random bytes encoded as base64url (≈43 chars). UNIQUE so lookups
  // by token are O(1) via index and we never collide.
  token        String    @unique
  status       String    @default("pending") // pending | used | expired
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  usedAt       DateTime?
  // The technician/admin who generated the token. SetNull on user delete
  // so we don't lose the audit row.
  createdById  String?
  // Channels picked by the operator when generating the token. Stored as
  // string array to keep the API flexible (e.g., ["EMAIL","WHATSAPP"]).
  sendChannels   String[] @default([])
  notifyChannels String[] @default([])
  // Captured on the first GET so the technician can spot suspicious use
  // (e.g., a token opened from an unexpected IP / device).
  ipAddress    String?
  userAgent    String?

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status, expiresAt])
  @@map("client_update_tokens")
}

model ClientEvidencePhoto {
  id           String   @id @default(cuid())
  clientId     String
  technicianId String?
  type         String   @default("other") // installation | support | visit | other
  description  String?
  fileUrl      String // public URL path, e.g. "/uploads/evidence/abc.jpg"
  fileName     String? // original filename
  mimeType     String?
  sizeBytes    Int?
  paymentId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([clientId])
  @@index([technicianId])
  @@index([paymentId])
  @@map("client_evidence_photos")
}

model Plan {
  id              String   @id @default(cuid())
  wisphubId       String?  @unique
  name            String
  type            String? // PPPoE, Hotspot, etc.
  description     String?
  price           Int // in cents
  monthlyPrice    Int      @default(0) // in cents (for frontend compatibility)
  downloadSpeed   Int // in kbps
  uploadSpeed     Int // in kbps
  dataLimit       Int? // in GB, null for unlimited
  // Technical name of the matching PPPoE profile on the MikroTik device
  // (e.g. "Online_basico"). When set, this overrides any plan.name fallback
  // when provisioning the secret. Must match a profile that actually exists
  // in /ppp/profile on the router.
  mikrotikProfile String?
  isActive        Boolean  @default(true)
  // Trueque / cortesía — el cliente provee energía o espacio físico para
  // equipos del ISP a cambio de servicio gratuito. Cuando isFree=true:
  //   • price y monthlyPrice se aceptan en 0 (no se valida "sin definir")
  //   • generateInvoices NO crea facturas para clientes en este plan
  //   • el cron de cobranza NO los lista como deudores (no aplica)
  //   • la UI muestra badge "Gratis" en /clients y en /clients/[id]
  isFree          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  clients Client[]

  @@map("plans")
}

model Device {
  id        String   @id @default(cuid())
  clientId  String
  mac       String   @unique
  ip        String?  @unique
  type      String // e.g., "router", "phone", "computer"
  model     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("devices")
}

model Invoice {
  id         String        @id @default(cuid())
  wisphubId  String?       @unique
  invoiceNumber String        @unique @map("number")
  clientId   String
  amount     Int // in cents
  tax        Int           @default(0) // in cents
  discount   Int           @default(0) // in cents
  total      Int // in cents
  status     InvoiceStatus @default(DRAFT)
  balanceDue Int           @default(0) // remaining amount in cents (0 when fully PAID)
  issueDate  DateTime      @default(now())
  dueDate    DateTime
  paidDate   DateTime?
  pdfUrl     String?
  notes      String?
  periodYear  Int? // year (e.g. 2026) — for month-based billing
  periodMonth Int? // month (1-12) — for month-based billing
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Relations
  client   Client          @relation(fields: [clientId], references: [id])
  payments Payment[]
  items    InvoiceItem[]
  paymentAttempts PaymentAttempt[]
  paymentLinks PaymentLink[]

  @@unique([clientId, periodYear, periodMonth])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  wisphubId   String?  @unique
  invoiceId   String
  quantity    Int      @default(1)
  description String
  price       Int // unit price in cents
  total       Int // line total in cents
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  clientId      String
  amount        Int // in cents
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  externalId    String? // For external payment systems
  notes         String?
  createdByUserId   String?
  createdByUserName String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  invoice    Invoice              @relation(fields: [invoiceId], references: [id])
  client     Client               @relation(fields: [clientId], references: [id])
  createdBy  User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  evidencePhotos ClientEvidencePhoto[]

  @@index([createdByUserId])
  @@map("payments")
}

// Tracks every Wompi checkout session / payment link generated from the
// backend. One row per `POST /checkout/sessions` call. The webhook handler
// updates status + webhookPayload when Wompi notifies us of the outcome,
// giving full traceability from link creation through to settlement.
model PaymentAttempt {
  id             String   @id @default(cuid())
  invoiceId      String
  clientId       String
  provider       String   @default("WOMPI")
  reference      String   @unique
  amount         Int // in cents
  status         String   @default("PENDING") // PENDING | COMPLETED | FAILED | EXPIRED
  checkoutUrl    String?  // The Wompi checkout URL the user is redirected to
  externalId     String?  // Wompi session ID (e.g. "sess_01h...")
  webhookPayload Json?    // Raw webhook payload from the transaction.updated event
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id])

  @@index([invoiceId])
  @@index([clientId])
  @@index([reference])
  @@map("payment_attempts")
}

model Router {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?
  apiPort          Int               @default(80)
  username         String            @default("admin")
  password         String
  isActive         Boolean           @default(true)
  location         String?
  model            String?
  firmware         String?
  lastSyncAt       DateTime?
  // Failover state — derived from the per-route ICMP monitor.
  //   ONLINE   = at least one route up and primary (priority=1) is up
  //   DEGRADED = primary down, at least one alternative up
  //   OFFLINE  = every route is down for ≥ probeDownCount consecutive sweeps
  //   UNKNOWN  = no route has been probed yet (fresh router)
  status           RouterStatus      @default(UNKNOWN)
  // Cached pointer to the route currently used to reach the box. Recomputed
  // every sweep; null when no route is online. NOT an FK on purpose — keeps
  // the migration simple; cleanup happens on next sweep if the route is gone.
  activeRouteId    Int?
  // Consecutive sweeps with ALL routes down. The OFFLINE Telegram alert is
  // gated by this so a single transient sweep doesn't page the operator.
  failCount        Int               @default(0)
  alertSent        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  // SSH connection for `.rsc` backup export (Backup module).
  // The username/password fields above are for RouterOS API; SSH may use
  // the same credentials (most setups) or a dedicated SSH user. Port
  // defaults to 22; sshUser falls back to `username` if null.
  sshPort  Int?    @default(22)
  sshUser  String?
  sshPass  String?

  mikrotikAccounts  MikrotikAccount[]
  zones             Zone[]
  routes            RouterRoute[]
  backups           RouterBackup[]
  backupSchedule    RouterBackupSchedule?

  @@map("routers")
}

// RouterBackup — one row per `.rsc` export run.
//   • triggeredBy: 'cron' | 'manual'
//   • status:      'pending' (running) | 'success' | 'failed'
//   • filePath:    absolute path under env.UPLOADS_PATH/backups/router-<id>
//
// Rotation: when a backup completes successfully, the service trims the
// oldest rows + files for this router beyond `retentionCount` from the
// schedule (or 30 if no schedule exists).
model RouterBackup {
  id           String   @id @default(cuid())
  routerId     Int
  fileName     String
  filePath     String
  sizeBytes    Int      @default(0)
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  status       String   @default("pending")
  errorMessage String?
  triggeredBy  String   @default("manual")
  createdById  String?

  router    Router @relation(fields: [routerId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([routerId, startedAt])
  @@map("router_backups")
}

// RouterBackupSchedule — at most one per router. Drives the cron tick.
//   • cronExpression: 5-field POSIX cron (e.g. "0 3 * * *" → 03:00 daily)
//   • retentionCount: keep last N backups, prune older
//   • nextRunAt / lastRunAt: maintained by the job, also useful in UI
model RouterBackupSchedule {
  id              String   @id @default(cuid())
  routerId        Int      @unique
  isActive        Boolean  @default(true)
  cronExpression  String   @default("0 3 * * *")
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  retentionCount  Int      @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  router Router @relation(fields: [routerId], references: [id], onDelete: Cascade)
  @@map("router_backup_schedules")
}

// One physical/logical path to the router. Up to 3 per router (1 primary +
// 2 alternativas) — enforced in the app layer, not in the schema. The ICMP
// monitor pings every route every sweep and exposes the per-route status to
// the UI so the operator can see exactly which uplink dropped.
model RouterRoute {
  id         Int         @id @default(autoincrement())
  routerId   Int
  ip         String // IPv4 reachable from the API host
  priority   Int // 1 = principal, 2 = alternativa 1, 3 = alternativa 2
  label      String? // e.g. "Enlace principal", "Backup fibra"
  status     RouteStatus @default(UNKNOWN)
  latency    Float? // ms, last successful ping (null when down/unknown)
  lastPingAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  router Router @relation(fields: [routerId], references: [id], onDelete: Cascade)

  // One row per priority slot per router. Enforces "no two routes at the
  // same priority" at the DB level so the failover ordering is unambiguous.
  @@unique([routerId, priority])
  @@index([routerId])
  @@index([status])
  @@map("router_routes")
}

enum RouterStatus {
  ONLINE
  DEGRADED
  OFFLINE
  UNKNOWN
}

enum RouteStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

model MikrotikAccount {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password      String
  remoteAddress String?
  localAddress  String?
  profileName   String?
  coordinates   String?
  status        String   @default("ACTIVE")
  routerId      Int
  router        Router   @relation(fields: [routerId], references: [id])
  clientId      String?  @unique
  client        Client?  @relation(fields: [clientId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("mikrotik_accounts")
}

model MikrotikConfig {
  id        String   @id @default(cuid())
  host      String
  port      Int      @default(8728)
  username  String
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mikrotik_configs")
}

model NotificationLog {
  id         String              @id @default(cuid())
  clientId   String?
  campaignId String? // null = transactional (single send), set = campaign delivery
  type       NotificationType
  channel    NotificationChannel
  recipient  String
  subject    String?
  content    String
  status     String // "sent" | "delivered" | "read" | "failed" | "pending" | "received"
  error      String?
  // External provider message id (e.g. WhatsApp message id) — used to
  // correlate webhook status callbacks back to the row we logged at send.
  externalId String?
  sentAt     DateTime?
  createdAt  DateTime            @default(now())

  campaign NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([clientId])
  @@index([externalId])
  @@map("notification_logs")
}

// Reusable message body with variable placeholders ({{name}}, {{plan}}, etc.)
model NotificationTemplate {
  id                   String   @id @default(cuid())
  name                 String
  channel              String // "EMAIL" | "WHATSAPP" — single channel per template (kept simple)
  subject              String? // only used by EMAIL
  body                 String // supports {{client.field}} substitution
  // Visual preset key for the styled HTML header (icon + title). One of:
  // invoice | reminder | service_suspended | service_activated |
  // payment_received | welcome | general_announcement. Defaults at render
  // time to 'general_announcement' when null. See email-base.template.js.
  preset               String?
  // WhatsApp-specific: name of the corresponding template approved in Meta
  // (e.g. "recordatorio_pago"). When set + channel="WHATSAPP" + the contact
  // is outside the 24h customer-service window, we send the template
  // message instead of free text. Body still holds the human-readable
  // copy for previews. Locale defaults to WhatsAppConfig.defaultLanguage.
  whatsappTemplateName String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  campaigns NotificationCampaign[]
  paymentLinkCampaigns PaymentLinkCampaign[]

  @@index([channel])
  @@map("notification_templates")
}

// One-shot batch send. The audience is captured as a JSON filter at send time
// and the actual deliveries live in NotificationLog tagged with campaignId.
model NotificationCampaign {
  id           String    @id @default(cuid())
  name         String
  templateId   String?
  channel      String // "EMAIL" | "WHATSAPP" | "BOTH"
  audienceJson String? // serialized filter: { zoneId, status, planId, overdue }
  status       String    @default("draft") // draft | running | completed | failed
  generatePaymentLinks Boolean @default(false)
  totalCount   Int       @default(0)
  sentCount    Int       @default(0)
  failedCount  Int       @default(0)
  scheduledAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdBy    String? // user.id
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  template   NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  deliveries NotificationLog[]

  @@index([status])
  @@index([createdAt])
  @@map("notification_campaigns")
}

// SMTP credentials managed from the UI (Notification Center → Correo SMTP).
// Only the row with isActive=true is used by notification.service when
// creating the email transporter. Falls back to .env if no row is active.
model SmtpConfig {
  id             String    @id @default(cuid())
  provider       String? // Preset name used in the UI (Gmail, Outlook, HostGator, etc.)
  host           String
  port           Int       @default(587)
  secure         Boolean   @default(false) // true for SSL (465), false for TLS (587)
  username       String
  password       String
  fromEmail      String
  fromName       String    @default("ISP Manager")
  replyTo        String?
  isActive       Boolean   @default(true)
  isVerified     Boolean   @default(false)
  lastTestedAt   DateTime?
  lastTestResult String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("smtp_configs")
}

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String // "string", "number", "boolean", "json"

  @@map("system_configs")
}

// ── Network Monitor (style: MikroTik The Dude) ────────────
// A node placed on the topology map. Position is persisted so the canvas
// re-renders identically across sessions. status/latency are updated by
// the ping engine (services/network-monitor.service.js) every 30s.
model NetworkDevice {
  id        String       @id @default(cuid())
  name      String
  ip        String
  type      DeviceType   @default(OTHER)
  zoneId    Int?
  posX      Float        @default(0)
  posY      Float        @default(0)
  status    DeviceStatus @default(UNKNOWN)
  latency   Float? // ms, last successful ping (null if down/unknown)
  lastSeen  DateTime? // last time the device responded
  // Consecutive failed pings since the last success. The device only flips to
  // OFFLINE (and only then is the down-alert fired) once failCount crosses
  // TelegramConfig.probeDownCount — see network-monitor.service.js. Resets to
  // 0 on the first successful probe.
  failCount Int          @default(0)
  // True once the down-alert for the current outage has been sent. Prevents
  // re-alerting on every subsequent failed probe, and gates the recovery
  // alert (we only send "recuperado" if we previously announced the outage).
  alertSent Boolean      @default(false)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  zone     Zone?               @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  outgoing NetworkConnection[] @relation("source")
  incoming NetworkConnection[] @relation("target")
  events   NetworkEvent[]

  @@index([status])
  @@index([zoneId])
  @@map("network_devices")
}

// Edge between two devices on the map. Both ends cascade on parent delete
// so we never leave dangling edges. label is freeform (e.g. "fibra", "PtP").
model NetworkConnection {
  id        String   @id @default(cuid())
  sourceId  String
  targetId  String
  label     String?
  createdAt DateTime @default(now())

  source NetworkDevice @relation("source", fields: [sourceId], references: [id], onDelete: Cascade)
  target NetworkDevice @relation("target", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
  @@map("network_connections")
}

// One row per state transition. We do NOT persist every ping — only the
// up→down / down→up / up→unstable transitions, plus the message used in
// the Telegram alert. Lets the history stay small while keeping the
// audit trail useful.
model NetworkEvent {
  id        String       @id @default(cuid())
  deviceId  String
  status    DeviceStatus
  latency   Float?
  loss      Float? // 0..100, packet loss %
  message   String?
  notified  Boolean      @default(false) // true once Telegram alert was sent
  createdAt DateTime     @default(now())

  device NetworkDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([createdAt])
  @@map("network_events")
}

// WhatsApp Cloud API (Meta) credentials managed from the UI (Centro de
// Notificaciones → WhatsApp). One active row at a time, same pattern as
// SmtpConfig / TelegramConfig. When no row is active, sendWhatsApp() is a
// no-op (logged once) so the rest of the notification pipeline keeps
// working with just email.
//
// `phoneId` is the WhatsApp Business phone number ID (NOT the phone
// number itself) — found in Meta WhatsApp Manager.
// `businessAccountId` (WABA) is informational; not required to send.
// `defaultLanguage` is the BCP-47 locale used for template messages
// (es_CO is the default for Colombia).
model WhatsAppConfig {
  id                String    @id @default(cuid())
  token             String // System User Bearer token from Meta
  phoneId           String // Meta phone number ID (numeric, e.g. "104382...")
  businessAccountId String? // WABA ID, informational
  displayName       String? // What shows in WhatsApp Manager (read-only mirror)
  defaultLanguage   String    @default("es_CO")
  isActive          Boolean   @default(true)
  isVerified        Boolean   @default(false)
  lastTestedAt      DateTime?
  lastTestResult    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("whatsapp_configs")
}

// Telegram bot config managed from the UI (Monitor de Red → Configuración).
// Only the row with isActive=true is consulted by telegram.service. When no
// row is active the monitor still runs but skips notifications.
model TelegramConfig {
  id               String    @id @default(cuid())
  botToken         String
  chatId           String // chat_id or @channelname
  isActive         Boolean   @default(true)
  alertOnDown      Boolean   @default(true)
  alertOnRecovery  Boolean   @default(true)
  // Polling engine parameters (style: MikroTik The Dude). The monitor reads
  // these every tick so changes apply within one cycle without a restart.
  probeIntervalSec Int       @default(30) // seconds between sweeps
  probeTimeoutSec  Int       @default(5) // seconds to wait for a ping reply
  probeDownCount   Int       @default(2) // consecutive failures before OFFLINE+alert
  lastTestedAt     DateTime?
  lastTestResult   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("telegram_configs")
}

enum DeviceType {
  ROUTER
  ANTENNA
  SWITCH
  ONT
  SERVER
  OTHER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNSTABLE
  UNKNOWN
}

// Shared map viewport (pan + zoom) per tab in /network. The key is
// 'all' | 'none' | 'zone:<id>' — that way the same model covers the
// special tabs and the real Zone tabs without polluting Zone itself.
// One row per tab, upserted by key. Shared across all users so the
// operator's preferred framing is the same for everybody.
model NetworkMapView {
  id        String   @id @default(cuid())
  key       String   @unique
  posX      Float    @default(0)
  posY      Float    @default(0)
  zoom      Float    @default(1)
  updatedAt DateTime @updatedAt
  updatedBy String? // user.id of the last writer (audit)

  @@map("network_map_views")
}

// Audit log for operator-initiated bulk operations. Purpose-built (vs.
// reusing NotificationLog which targets customers) so audit queries
// stay clean: every row is a single operator action against N entities.
//
// `payload` captures what was requested (planId, syncMikrotik flag, etc.).
// `results` captures per-entity outcome — array of
// { entityId, status: 'ok' | 'noop' | 'skipped' | 'failed', changes?, reason? }
// Storing both as JSON keeps the schema flexible as new bulk operations
// (mass invoice generation, bulk profile sync, etc.) reuse this table.
model BulkOperationLog {
  id          String   @id @default(cuid())
  // 'BULK_PLAN_CHANGE' for now. Extend as new ops land.
  type        String
  operatorId  String?
  payload     Json
  results     Json
  // Quick-glance counters so the operator list view doesn't have to parse
  // the JSON to render row badges.
  totalCount  Int      @default(0)
  okCount     Int      @default(0)
  failedCount Int      @default(0)
  createdAt   DateTime @default(now())

  operator User? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([operatorId])
  @@map("bulk_operation_logs")
}

// Collection windows — operator-defined date ranges during which an
// automatic reminder campaign runs against debtor clients. Drives the
// FASE 4 cron: the worker wakes hourly, finds the currently-active
// window (only one is allowed via the partial unique index below), then
// for each debtor in scope checks NotificationLog to avoid spam.
//
// Fields:
//   • startDate / endDate          half-open [start, end) at minute precision
//   • targetStatuses               which invoice statuses count as "owing"
//                                  for this window (default: PENDING + OVERDUE)
//   • channels                     EMAIL / WHATSAPP / TELEGRAM
//   • sendFrequencyHours           min spacing between reminders per client
//   • messageTemplate              text with {name} / {amount} / {dueDate}
//                                  placeholders
//   • isActive                     manual on/off override; the cron also
//                                  respects start/end window bounds
//
// A SystemConfig key cannot replace this — we want history, multiple past
// windows, and per-window metrics in FASE 5.
model CollectionWindow {
  id                  String   @id @default(cuid())
  name                String   // operator-facing label (e.g. "Cierre Junio")
  startDate           DateTime
  endDate             DateTime
  targetStatuses      String[] @default(["PENDING","OVERDUE"])
  channels            String[] @default(["EMAIL"])
  sendFrequencyHours  Int      @default(24)
  messageTemplate     String   @default("Hola {name}, tu factura por {amount} vence el {dueDate}. Realiza tu pago para evitar inconvenientes.")
  isActive            Boolean  @default(true)
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, startDate, endDate])
  @@map("collection_windows")
}

// BillingCycle — parámetro mensual del ciclo de cobro del servicio.
// Un row por (year, month). Gobierna las FECHAS del ciclo (inicio de cobro
// y fecha máxima de pago), el estado del período, notas operativas y un
// toggle SEPARADO de "corte automático" que está OFF por defecto.
//
// Lo que ESTE modelo NO hace:
//   • No genera facturas (eso es bulk-billing).
//   • No suspende servicios (esa es una política manual).
//   • No envía notificaciones (eso es CollectionWindow / auto-collection).
//
// Lo que SÍ hace:
//   • Clasifica clientes en buckets para el período (al día, dentro de
//     ventana, vencido, en mora, suspendible) consultable vía endpoint.
//   • Persiste la decisión de fechas por mes para auditoría/UI.
//
// Estados:
//   draft   — el operador está configurando, sin efecto en clasificación
//   active  — el ciclo en curso; el clasificador lo usa como referencia
//   closed  — ciclo histórico, read-only en UI
//
// Reglas derivadas:
//   • Solo PUEDE haber un cycle 'active' a la vez (verificación en service).
//   • moraGraceDays define cuántos días después de collectionEnd un cliente
//     pasa de "vencido" a "mora" (default 7).
//   • autoSuspendEnabled NO ejecuta corte; sólo habilita la etiqueta
//     "suspendible" en el clasificador.
model BillingCycle {
  id                 String   @id @default(cuid())
  year               Int                                  // ej. 2026
  month              Int                                  // 1..12
  collectionStart    DateTime                             // fecha de inicio de cobro (ej. 25 jun)
  collectionEnd      DateTime                             // fecha máxima de pago (ej. 30 jun)
  moraGraceDays      Int      @default(7)
  status             String   @default("draft")           // draft | active | closed
  autoSuspendEnabled Boolean  @default(false)
  notes              String?
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([year, month])
  @@index([status, year, month])
  @@map("billing_cycles")
}

// ── Portal de Cliente ──────────────────────────────────────────────

// ClientUser — 1:1 con Client. Almacena la contraseña (bcrypt) para
// que el cliente acceda a su portal de autoservicio. Se crea la primera
// vez que el cliente establece su contraseña (vía link de bienvenida o
// manualmente desde el admin).
model ClientUser {
  id             String   @id @default(cuid())
  clientId       String   @unique
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email          String   @unique // denormalizado de Client para login rápido
  passwordHash   String
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  lastIp         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions    ClientSession[]
  resetTokens ClientResetToken[]

  @@map("client_users")
}

// ClientSession — sesión JWT para clientes. Mismo patrón que Session
// (admin): el token JWT se persiste en DB para revocación inmediata.
model ClientSession {
  id           String      @id @default(cuid())
  clientUserId String
  clientUser   ClientUser  @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  token        String      @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())

  @@index([clientUserId])
  @@map("client_sessions")
}

// ClientResetToken — token de un solo uso para restablecer contraseña.
model ClientResetToken {
  id           String      @id @default(cuid())
  clientUserId String
  clientUser   ClientUser  @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  token        String      @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime    @default(now())

  @@index([clientUserId])
  @@index([token])
  @@map("client_reset_tokens")
}

// ── Enlaces de Pago ────────────────────────────────────────────────

// PaymentLink — un enlace de pago generado para un cliente. Puede
// asociarse a una factura específica o ser genérico. Se envía al
// cliente por Email/WhatsApp y se rastrea su estado hasta el pago.
model PaymentLink {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
  campaignId     String?
  campaign       PaymentLinkCampaign? @relation(fields: [campaignId], references: [id])
  reference      String   @unique
  amountInCents  Int
  currency       String   @default("COP")
  wompiLinkId    String?  // ID from Wompi payment_links response
  checkoutUrl    String?  // https://checkout.wompi.co/l/{id}
  status         String   @default("pending") // pending | sent | opened | paid | expired | cancelled
  expiresAt      DateTime?
  sentAt         DateTime?
  openedAt       DateTime?
  paidAt         DateTime?
  paymentAttemptId String? // link al PaymentAttempt cuando se genera
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId])
  @@index([invoiceId])
  @@index([status])
  @@map("payment_links")
}

// PaymentLinkCampaign — campaña de envío masivo de enlaces de pago.
// Agrupa múltiples PaymentLink y rastrea métricas agregadas.
model PaymentLinkCampaign {
  id             String   @id @default(cuid())
  name           String
  description    String?
  templateId     String?
  template       NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  channel        String   @default("EMAIL") // EMAIL | WHATSAPP | BOTH
  status         String   @default("draft") // draft | scheduled | sending | sent | partial | cancelled
  scheduledAt    DateTime?
  sentAt         DateTime?
  totalCount     Int      @default(0)
  sentCount      Int      @default(0)
  openedCount    Int      @default(0)
  paidCount      Int      @default(0)
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  paymentLinks   PaymentLink[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("payment_link_campaigns")
}

// ── Auditoría de Notificaciones al Cliente ─────────────────────────

// ClientNotification — registro individual de cada notificación enviada
// a un cliente. Complementa NotificationLog con trazabilidad específica
// del enlace de pago (apertura, pago). Cada fila representa un envío
// por un canal a un cliente.
model ClientNotification {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaignId     String?  // PaymentLinkCampaign.id si aplica
  paymentLinkId  String?  // PaymentLink.id si aplica
  type           String   // payment_link | reminder | announcement
  channel        String   // EMAIL | WHATSAPP | SMS | TELEGRAM
  recipient      String   // email o teléfono
  subject        String?
  content        String   @db.Text
  linkUrl        String?  // URL del enlace de pago
  status         String   @default("pending") // pending | sent | delivered | opened | failed
  externalId     String?  // ID del proveedor (ej. message_id de WhatsApp)
  error          String?
  sentAt         DateTime?
  openedAt       DateTime?
  createdAt      DateTime @default(now())

  @@index([clientId])
  @@index([campaignId])
  @@index([paymentLinkId])
  @@index([status])
  @@map("client_notifications")
}
