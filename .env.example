# ─── Required ─────────────────────────────────────────────────
# Database
POSTGRES_DB=isp_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__SET_ME__
# Compose builds DATABASE_URL from POSTGRES_* above. For local-only Node runs,
# set DATABASE_URL directly:
# DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/isp_manager"

# Redis
REDIS_PASSWORD=__SET_ME__
# REDIS_URL="redis://:redis123@localhost:6379"   # only when running Node outside docker

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=__GENERATE_WITH_OPENSSL_RAND__
JWT_EXPIRES_IN=8h

# Frontend origin (CORS allowlist + reset links)
FRONTEND_URL=http://localhost:3000

# SMTP — required for invoice emails / password resets.
# Also editable from /smtp UI; these are bootstrap fallback.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=__SET_ME__
SMTP_PASS=__SET_ME__

# Company branding (PDFs, emails)
COMPANY_NAME=Mi ISP
COMPANY_NIT=000000000-0
COMPANY_CITY=Cali
COMPANY_ADDRESS=Cra 123 #45-67
COMPANY_PHONE=+57 2 000 0000
COMPANY_EMAIL=contacto@miisp.com

# Wompi (Colombia payment gateway)
WOMPI_API_URL=https://api.wompi.co/v1
WOMPI_PUBLIC_KEY=__SET_ME__
WOMPI_PRIVATE_KEY=__SET_ME__
WOMPI_EVENTS_KEY=__SET_ME__

# ─── Optional ─────────────────────────────────────────────────
# Runtime
NODE_ENV=development
PORT=3001
UPLOADS_PATH=./uploads
MAX_FILE_SIZE=10485760

# Rate limiting (defaults: 100 req / 15 min per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# MikroTik — global default. Per-router config lives in the `routers` table;
# leave blank if you have no global fallback router.
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USER=
MIKROTIK_PASSWORD=

# WhatsApp Cloud (Meta) — real config in WhatsAppConfig table.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERSION=v18.0

# Twilio — scaffold (SMS channel not implemented yet)
TWILIO_SID=
TWILIO_AUTH=
TWILIO_PHONE=

# PgAdmin (docker compose only)
PGADMIN_DEFAULT_EMAIL=admin@isp-manager.com
PGADMIN_DEFAULT_PASSWORD=__SET_ME__
